rules_version = '2';

// Vouch — one owner, one partner, one promise.
//
// Every track is readable by its two members only. The partner joins through a
// short-lived invite document (get, never list). Day documents are split by
// field ownership: the owner writes the note, the partner writes the mark.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(track) {
      return signedIn() && track.ownerUid == uid();
    }

    function isPartner(track) {
      return signedIn() && track.partnerUid != null && track.partnerUid == uid();
    }

    function isMember(track) {
      return signedIn() && uid() in track.memberUids;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function maxText(value, limit) {
      return value is string && value.size() <= limit;
    }

    function optionalText(value, limit) {
      return value == null || maxText(value, limit);
    }

    function validPromise(value) {
      return value is string && value.size() > 0 && value.size() <= 140;
    }

    function validInviteCode(value) {
      return value is string && value.matches('^[A-Z0-9]{8}$');
    }

    function validDayKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validSchedule(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly(['kind', 'hour', 'minute', 'timeZone'])
        && value.kind in ['daily', 'weekdays', 'weekends']
        && value.hour is int && value.hour >= 0 && value.hour <= 23
        && value.minute is int && value.minute >= 0 && value.minute <= 59
        && value.timeZone is string && value.timeZone.size() > 0
        && value.timeZone.size() <= 64
      );
    }

    function validStatus(value) {
      return value in ['waiting', 'active', 'paused', 'ended'];
    }

    function validMarkStatus(value) {
      return value in ['pending', 'completed', 'missed'];
    }

    function validMethod(value) {
      return value == null || value in ['inPerson', 'call', 'message', 'other'];
    }

    // The invite must be live and must point back at this track. Rules get()
    // calls bypass security rules, so this is safe for a pre-join partner.
    function inviteIsLive(trackId, code, expiresAt) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.trackId == trackId
        && invite.expiresAt is timestamp
        && expiresAt is timestamp
        && invite.expiresAt > request.time
        && expiresAt > request.time;
    }

    // ------------------------------------------------------------------
    // Users — each person owns their mirror document.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && userId == uid();
    }

    // ------------------------------------------------------------------
    // Tracks
    // ------------------------------------------------------------------
    match /tracks/{trackId} {
      allow read: if isMember(resource.data);

      allow create: if isOwner(request.resource.data)
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.partnerUid == null
        && request.resource.data.schedule == null
        && request.resource.data.startedAt == null
        && request.resource.data.status == 'waiting'
        && validPromise(request.resource.data.promise)
        && optionalText(request.resource.data.promiseNote, 600)
        && maxText(request.resource.data.ownerName, 80)
        && optionalText(request.resource.data.ownerPhotoUrl, 600)
        && optionalText(request.resource.data.ownerPhone, 32)
        && request.resource.data.keys().hasAll([
          'promise', 'ownerUid', 'ownerName', 'memberUids', 'inviteCode',
          'inviteExpiresAt', 'status', 'createdAt', 'updatedAt'
        ]);

      allow update: if
        // The owner edits the promise, their contact details, or ends it.
        (isOwner(resource.data)
          && changedKeys().hasOnly([
            'promise', 'promiseNote', 'ownerName', 'ownerPhone',
            'ownerPhotoUrl', 'inviteCode', 'inviteExpiresAt',
            'status', 'endedAt', 'updatedAt'
          ])
          && validPromise(request.resource.data.promise)
          && optionalText(request.resource.data.promiseNote, 600)
          && optionalText(request.resource.data.ownerPhone, 32)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.partnerUid == resource.data.partnerUid
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.schedule == resource.data.schedule
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'ended'
                  && request.resource.data.endedAt is timestamp))
        )
        // The partner claims an unclaimed track through a live invite.
        || (signedIn()
          && resource.data.partnerUid == null
          && request.resource.data.partnerUid == uid()
          && request.resource.data.memberUids
              == resource.data.memberUids.concat([uid()])
          && changedKeys().hasOnly([
            'partnerUid', 'partnerName', 'partnerPhotoUrl',
            'memberUids', 'updatedAt'
          ])
          && maxText(request.resource.data.partnerName, 80)
          && optionalText(request.resource.data.partnerPhotoUrl, 600)
          && resource.data.status == 'waiting'
          && inviteIsLive(trackId, resource.data.inviteCode,
              resource.data.inviteExpiresAt)
        )
        // The partner sets the rhythm and their contact number.
        || (isPartner(resource.data)
          && changedKeys().hasOnly([
            'schedule', 'status', 'startedAt', 'partnerName',
            'partnerPhotoUrl', 'partnerPhone', 'updatedAt'
          ])
          && validSchedule(request.resource.data.schedule)
          && optionalText(request.resource.data.partnerPhone, 32)
          && maxText(request.resource.data.partnerName, 80)
          && request.resource.data.status
              in [resource.data.status, 'active']
          && (request.resource.data.status != 'active'
              || validSchedule(request.resource.data.schedule))
        )
        // The partner steps away; the track returns to waiting.
        || (isPartner(resource.data)
          && changedKeys().hasOnly([
            'partnerUid', 'partnerName', 'partnerPhotoUrl', 'partnerPhone',
            'schedule', 'startedAt', 'status', 'memberUids', 'updatedAt'
          ])
          && request.resource.data.partnerUid == null
          && request.resource.data.partnerName == null
          && request.resource.data.partnerPhotoUrl == null
          && request.resource.data.partnerPhone == null
          && request.resource.data.schedule == null
          && request.resource.data.startedAt == null
          && request.resource.data.status == 'waiting'
          && request.resource.data.memberUids
              == resource.data.memberUids.removeAll([uid()])
        );

      allow delete: if false;

      // ----------------------------------------------------------------
      // Day entries — owner owns the note, partner owns the mark.
      // ----------------------------------------------------------------
      match /days/{day} {
        function track() {
          return get(/databases/$(database)/documents/tracks/$(trackId)).data;
        }

        function noteFields() {
          return request.resource.data.date == day
            && maxText(request.resource.data.note, 2000)
            && request.resource.data.noteUpdatedAt == request.time;
        }

        function markFields() {
          return request.resource.data.date == day
            && validMarkStatus(request.resource.data.status)
            && request.resource.data.markedBy == uid()
            && request.resource.data.markedAt == request.time
            && validMethod(request.resource.data.method);
        }

        allow read: if isMember(track());

        allow create: if validDayKey(day) && (
          (isOwner(track())
            && request.resource.data.keys()
                .hasOnly(['date', 'note', 'noteUpdatedAt'])
            && noteFields())
          || (isPartner(track())
            && request.resource.data.keys()
                .hasOnly(['date', 'status', 'markedBy', 'markedAt',
                           'method', 'partnerNote'])
            && markFields()
            && optionalText(request.resource.data.partnerNote, 500))
        );

        allow update: if validDayKey(day) && (
          (isOwner(track())
            && changedKeys().hasOnly(['note', 'noteUpdatedAt'])
            && noteFields())
          || (isPartner(track())
            && changedKeys().hasOnly(['status', 'markedBy', 'markedAt',
                                      'method', 'partnerNote'])
            && markFields()
            && optionalText(request.resource.data.partnerNote, 500))
        );

        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Invites — readable by code only, written by the track owner.
    // ------------------------------------------------------------------
    match /invites/{code} {
      allow get: if signedIn() && validInviteCode(code);
      allow list: if false;

      allow create: if signedIn() && validInviteCode(code)
        && request.resource.data.ownerUid == uid()
        && request.resource.data.keys().hasOnly([
          'trackId', 'ownerUid', 'promise', 'ownerName', 'ownerPhotoUrl',
          'createdAt', 'expiresAt'
        ])
        && maxText(request.resource.data.trackId, 160)
        && validPromise(request.resource.data.promise)
        && maxText(request.resource.data.ownerName, 80)
        && optionalText(request.resource.data.ownerPhotoUrl, 600)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt
            <= request.time + duration.value(8, 'd');

      allow delete: if signedIn() && resource.data.ownerUid == uid();

      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Published from the Vouch repository.